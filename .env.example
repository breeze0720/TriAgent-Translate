# 复制成 .env 后填写下方空白项（带 * 的是必填）
# ============================================
# 多智能体协作翻译与审校系统 - 环境变量配置
# ============================================

# Qwen 模型（负责审校 Agent，善于分析和评判）
QWEN_MODEL_NAME=qwen3.7-max
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# DeepSeek 模型（负责翻译和润色 Agent，中文翻译能力强）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_NAME=deepseek-chat

# 邮件发送配置（QQ邮箱 SMTP）
EMAIL_HOST=smtp.qq.com
EMAIL_FROM=your_email@qq.com
EMAIL_PASSWORD=

# MySQL 数据库配置
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=agent_translate

# ---- 第二审校模型（智谱 GLM，可选）：不填 GLM_API_KEY 就自动单模型审校 ----
GLM_API_KEY=
GLM_MODEL_NAME=glm-4.6
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
REVIEW_PROVIDERS=
REVIEW_VOTE_DIFF=10

# ---- 四节点四模型（provider:model）----
# 只写 provider 就用它的默认模型名。某个 provider 没 key 时会自动降到本节点的候选模型，
# 启动日志会打印实际生效的四个模型（带 * 号表示发生了降级）。
MODEL_TERMINOLOGY=glm:glm-4-flash
MODEL_TRANSLATE=deepseek:deepseek-chat
MODEL_REVIEW=qwen:qwen3.7-max
MODEL_POLISH=glm:glm-4.6

# 可选：开启双模型审校投票（两个 provider 都要有 key），例如 REVIEW_PROVIDERS=qwen,glm
